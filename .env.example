# MongoDB Atlas
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=prg_automation

# Claude AI (on by default once a key is present). Never commit the real .env
ANTHROPIC_API_KEY=
# Optional overrides - defaults shown. FAST = classification/enrichment/text, STRONG = drawing images only
# PRG_MODEL_FAST=claude-haiku-5-5
# PRG_MODEL_STRONG=claude-sonnet-5-5
# Free alternatives to Claude (used automatically when ANTHROPIC_API_KEY is empty; first key found wins:
# Gemini -> Groq -> OpenRouter -> Ollama). Force one with PRG_AI_PROVIDER=anthropic|gemini|groq|openrouter|ollama
# NOTE: free tiers may log/train on prompts - do not send confidential client drawings through them without approval.
PRG_AI_PROVIDER=auto
# https://aistudio.google.com/apikey (free tier, supports images)
GEMINI_API_KEY=
# https://console.groq.com/keys (free tier, Llama 4 vision)
GROQ_API_KEY=
# https://openrouter.ai/keys (models ending in :free)
OPENROUTER_API_KEY=
# Ollama = fully local and private, no key. Install Ollama, `ollama pull qwen2.5:7b` and `ollama pull llama3.2-vision`
OLLAMA_MODEL=
OLLAMA_VISION_MODEL=
# Optional: path to tesseract.exe for OCR of scanned PDFs
TESSERACT_CMD=

# Runtime
PRG_DB=
