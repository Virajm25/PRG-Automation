{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "{templates/**,core/**,app.py}",
      "excludeFiles": "{Docs/**,tests/**,installer/**,documentation/**,data/**,dist/**,build/**,.venv/**,.claude/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index?__path=$1"
    }
  ]
}
